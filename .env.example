# GEMINI_API_KEY: Optional Gemini AI API key for intelligent metadata features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The hosting service URL
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Telegram Bot Token from @BotFather for initData HMAC validation
TELEGRAM_BOT_TOKEN="777888999:AAFF_QANI_DEMO_BOT_TOKEN"

# DATABASE_URL: PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://qani_user:qani_pass@localhost:5432/qani_db?schema=public"

# REDIS_URL: Redis connection for queue worker
REDIS_URL="redis://localhost:6379"

# S3 Object Storage Configuration
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="qani-videos"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadminpassword"

# NODE_ENV: development or production
NODE_ENV="development"
