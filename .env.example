# ─── Telegram ─────────────────────────────────────────────────
# @BotFather dan olingan bot token
TELEGRAM_BOT_TOKEN="777888999:AAFF_QANI_DEMO_BOT_TOKEN"

# ─── Database: Neon (bepul 500MB) ─────────────────────────────
# https://neon.tech → New Project → Connection String
DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/qani_db?sslmode=require"

# ─── Redis: Upstash (bepul 10K command/kun) ─────────────────────
# https://upstash.com → Redis → New Database → REDIS_URL
REDIS_URL="rediss://default:xxx@xxx.upstash.io:6379"

# ─── File Storage: Supabase (bepul 1GB) ───────────────────────
# https://supabase.com → New Project → Settings → API
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_KEY="eyJ..."
# Eslatma: Storage → Buckets → "videos" bucket yarating!

# ─── AI: Gemini (bepul tier) ────────────────────────────────────
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ─── App ────────────────────────────────────────────────────────
APP_URL="https://qani.vercel.app"
JWT_SECRET="bu_yerga_32_talik_kuchli_kalit_yozing"
NODE_ENV="production"

